<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.gwtbootstrap3</groupId>
  <artifactId>gwt-bootstrap-modern</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>GWT Bootstrap Modern</name>
  <description>Maintained GwtBootstrap3-compatible fork with a separate Bootstrap 5 migration track.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <organization>
    <name>GWT Bootstrap Modern</name>
    <url>https://github.com/cstainton/gwtbootstrap-modern</url>
  </organization>

  <scm>
    <connection>scm:git:https://github.com/cstainton/gwtbootstrap-modern.git</connection>
    <developerConnection>scm:git:git@github.com:cstainton/gwtbootstrap-modern.git</developerConnection>
    <url>https://github.com/cstainton/gwtbootstrap-modern</url>
  </scm>

  <modules>
    <module>gwt-bootstrap3-modern</module>
    <module>gwt-bootstrap3-modern-extras</module>
    <module>gwt-bootstrap3-modern-showcase</module>
    <module>gwt-bootstrap5-modern</module>
    <module>gwt-bootstrap5-modern-showcase</module>
    <module>gwt-teavm-compat</module>
    <module>teavm-bootstrap3-modern</module>
    <module>teavm-bootstrap5-modern</module>
  </modules>

  <properties>
    <dependency-check-maven.version>12.1.0</dependency-check-maven.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>8</maven.compiler.release>
    <gwt.version>2.13.1</gwt.version>
    <bootstrap.version>3.4.1</bootstrap.version>
    <bootstrap5.version>5.3.8</bootstrap5.version>
    <jquery.compat.version>3.7.1</jquery.compat.version>
    <bootbox.version>6.0.4</bootbox.version>
    <bootstrap.datepicker.version>1.10.1</bootstrap.datepicker.version>
    <bootstrap.datetimepicker.version>2.4.4</bootstrap.datetimepicker.version>
    <bootstrap.select.version>1.14.0-beta3</bootstrap.select.version>
    <bootstrap.slider.version>11.0.2</bootstrap.slider.version>
    <bootstrap.switch.version>3.4.0</bootstrap.switch.version>
    <typeahead.version>0.11.1</typeahead.version>
    <animate.version>4.1.1</animate.version>
    <summernote.version>0.9.1</summernote.version>
    <fullcalendar.version>3.10.5</fullcalendar.version>
    <jquery.ui.version>1.13.3</jquery.ui.version>
    <moment.version>2.30.1</moment.version>
    <blueimp.gallery.version>3.4.0</blueimp.gallery.version>
    <teavm.version>0.15.0</teavm.version>
  </properties>
  <profiles>
    <profile>
      <id>dependency-audit</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>${dependency-check-maven.version}</version>
            <configuration>
              <nvdApiKey>${nvdApiKey}</nvdApiKey>
              <failBuildOnCVSS>11</failBuildOnCVSS>
              <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
              <skipProvidedScope>true</skipProvidedScope>
              <skipTestScope>true</skipTestScope>
              <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
