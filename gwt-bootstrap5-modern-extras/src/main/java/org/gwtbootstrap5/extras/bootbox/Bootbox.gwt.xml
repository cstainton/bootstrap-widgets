<!--
  Bootbox 6, which targets Bootstrap 5 and is a jQuery plugin.

  Inheriting the jQuery extra rather than assuming the page has it: the core
  Bootstrap 5 widget library ships no jQuery, so an application only acquires it
  by inheriting an extra like this one that genuinely needs it.
-->
<module rename-to='bootbox'>
    <inherits name="org.gwtbootstrap5.extras.jquery.JQuery"/>
    <inherits name="com.google.gwt.resources.Resources"/>

    <source path='client'/>

    <entry-point class="org.gwtbootstrap5.extras.bootbox.client.BootboxEntryPoint"/>
</module>
