<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.gwtbootstrap3</groupId>
    <artifactId>gwt-bootstrap-modern</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>teavm-bootstrap5-modern</artifactId>
  <name>GWT Bootstrap 5 Modern TeaVM Widget Backend</name>
  <packaging>jar</packaging>
  <description>Bootstrap 5-native TeaVM widget backend built without UiBinder or GWT DOM dependencies.</description>

  <dependencies>
    <dependency>
      <groupId>org.gwtbootstrap3</groupId>
      <artifactId>gwt-teavm-compat</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso-apis</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        The Bootstrap 5 widget API is compiled from the GWT module's own sources, so the
        TeaVM build and the GWT build share one definition of every widget rather than
        maintaining a parallel copy. Two groups are excluded:
          * CellTable, DataGrid, ButtonCell and FormPanel - the GWT cell-widget and
            form-submit bridges, which are GWT data-presentation machinery rather than
            Bootstrap widgets. HTMLPanel and FlowPanel stay: html.Span and
            html.Paragraph extend them;
          * the eight JSNI-bridging widgets, which this module re-implements against
            TeaVM's @JSBody in src/main/java under the same package and API.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-shared-bootstrap5-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../gwt-bootstrap5-modern/src/main/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>org/gwtbootstrap5/client/ui/gwt/CellTable.java</exclude>
            <exclude>org/gwtbootstrap5/client/ui/gwt/DataGrid.java</exclude>
            <exclude>org/gwtbootstrap5/client/ui/gwt/ButtonCell.java</exclude>
            <exclude>org/gwtbootstrap5/client/ui/gwt/FormPanel.java</exclude>
            <exclude>org/gwtbootstrap5/client/GwtBootstrap5EntryPoint.java</exclude>
            <exclude>org/gwtbootstrap5/client/shared/js/JQuery.java</exclude>
            <exclude>org/gwtbootstrap5/client/ui/Alert.java</exclude>
            <exclude>org/gwtbootstrap5/client/ui/base/AbstractTooltip.java</exclude>
            <exclude>org/gwtbootstrap5/client/ui/base/BootstrapEventBridge.java</exclude>
            <exclude>org/gwtbootstrap5/client/ui/Carousel.java</exclude>
            <exclude>org/gwtbootstrap5/client/ui/Collapse.java</exclude>
            <exclude>org/gwtbootstrap5/client/ui/Modal.java</exclude>
            <exclude>org/gwtbootstrap5/client/ui/ScrollSpy.java</exclude>
            <exclude>org/gwtbootstrap5/client/ui/TabListItem.java</exclude>
          </excludes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>${teavm.version}</version>
        <executions>
          <execution>
            <id>compile-teavm-bootstrap5-smoke-app</id>
            <phase>process-classes</phase>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <mainClass>org.gwtbootstrap5.teavm.demo.Bootstrap5SmokeApp</mainClass>
              <targetDirectory>${project.build.directory}/teavm</targetDirectory>
              <targetFileName>teavm-bootstrap5-modern-smoke.js</targetFileName>
              <minifying>false</minifying>
              <sourceMapsGenerated>true</sourceMapsGenerated>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
