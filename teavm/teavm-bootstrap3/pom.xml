<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>teavm-bootstrap-widgets</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>teavm-bootstrap3</artifactId>
  <name>TeaVM Bootstrap 3</name>
  <packaging>jar</packaging>
  <description>TeaVM-backed Bootstrap 3 widget API, sharing the GWT track sources.</description>

  <dependencies>
    <!--
      The extras, unpacked one at a time. Only the ported ones are taken, so adding
      an extra is a line in the include list below rather than a wall of exclusions
      for the seventeen that are not ready.
    -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>gwt-bootstrap3-extras</artifactId>
      <version>${project.version}</version>
      <classifier>sources</classifier>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Unpacked below; provided so it reaches no consumer. -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>gwt-bootstrap3</artifactId>
      <version>${project.version}</version>
      <classifier>sources</classifier>
      <scope>provided</scope>
      <!--
        Source only. Without this the artifact's own dependencies follow it in,
        including the GWT-compiled jars of these very modules, and TeaVM then links
        against bytecode built for the other compiler.
      -->
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Unpacked below; provided so it reaches no consumer. -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>gwt-bootstrap3-themes</artifactId>
      <version>${project.version}</version>
      <classifier>sources</classifier>
      <scope>provided</scope>
      <!--
        Source only. Without this the artifact's own dependencies follow it in,
        including the GWT-compiled jars of these very modules, and TeaVM then links
        against bytecode built for the other compiler.
      -->
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Unpacked below; provided so it reaches no consumer. -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>gwt-bootstrap3-showcase</artifactId>
      <version>${project.version}</version>
      <classifier>sources</classifier>
      <scope>provided</scope>
      <!--
        Source only. Without this the artifact's own dependencies follow it in,
        including the GWT-compiled jars of these very modules, and TeaVM then links
        against bytecode built for the other compiler.
      -->
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>teavm-gwt-compat</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- theme catalogue only; the stylesheets are served by the host page -->
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso-apis</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
    </dependency>
  </dependencies>

  <properties>
    <shared.source.artifacts>gwt-bootstrap3,gwt-bootstrap3-themes,gwt-bootstrap3-showcase</shared.source.artifacts>
  </properties>

  <build>
    <plugins>
      <!-- Unpacks the shared widget sources; configured in the parent. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
      </plugin>

      <!--
        The TeaVM counterpart of an extra's GWT module: a class that loads what the
        module declares and says when it is usable. Reads the same .gwt.xml and
        ClientBundle the GWT build reads, from the unpacked sources.
      -->
      <plugin>
        <groupId>io.instanto</groupId>
        <artifactId>teavm-module-maven-plugin</artifactId>
        <version>${project.version}</version>
        <executions>
          <execution>
            <id>generate-teavm-modules</id>
            <phase>process-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <sourceRoot>${project.build.directory}/shared-sources</sourceRoot>
              <outputRoot>${project.build.directory}/generated-sources/teavm-modules</outputRoot>
              <assetRoot>${project.build.directory}/teavm</assetRoot>
              <packagedRoot>${project.build.outputDirectory}/META-INF/bootstrap3-assets</packagedRoot>
              <resourcesClass>org.gwtbootstrap3.client.Bootstrap3Resources</resourcesClass>
              <idPrefix>gwtbootstrap3-</idPrefix>
              <!-- The extras that are ported. One line per extra as each lands. -->
              <includeModules>
                <includeModule>Markdown</includeModule>
                <includeModule>CardResources</includeModule>
              </includeModules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>unpack-ported-bootstrap3-extras</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <configuration>
              <classifier>sources</classifier>
              <includeArtifactIds>gwt-bootstrap3-extras</includeArtifactIds>
              <includes>org/gwtbootstrap3/extras/card/**,org/gwtbootstrap3/extras/markdown/**</includes>
              <outputDirectory>${project.build.directory}/shared-sources</outputDirectory>
              <overWriteSnapshots>true</overWriteSnapshots>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        The Bootstrap 3 widget API is compiled from the GWT module's own sources, so the
        TeaVM build and the GWT build share one definition of every widget rather than
        maintaining a parallel copy. Two groups are excluded:
          * the entry point and the jQuery bridge, which this module re-implements
            against TeaVM's @JSBody under the same package and API.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-shared-bootstrap3-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.build.directory}/shared-sources</source>
                <source>${project.build.directory}/generated-sources/teavm-modules</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!--
            UiBinder for TeaVM, as on the Bootstrap 5 module. The showcase templates are
            the point: forty-one of the fifty-five pages are ordinary widget code, and
            this is what turns their .ui.xml into something both compilers can build.
          -->
          <annotationProcessorPaths>
            <path>
              <groupId>io.instanto</groupId>
              <artifactId>widget-processor</artifactId>
              <version>${project.version}</version>
            </path>
          </annotationProcessorPaths>
          <excludes>
            <!--
              The fourteen showcase pages backed by gwt-bootstrap3-extras, which is not
              ported: it reaches the browser through 352 JSNI methods. ExtrasPages is
              the seam; this module supplies its own, returning null for every token.
            -->
            <exclude>org/gwtbootstrap3/demo/client/ExtrasPages.java</exclude>
            <!-- Seam: prettify.js arrives by URL here, not inlined by a ClientBundle. -->
            <exclude>org/gwtbootstrap3/demo/client/ShowcaseScripts.java</exclude>
            <exclude>org/gwtbootstrap3/demo/client/ui/PrettyPre.java</exclude>
            <exclude>org/gwtbootstrap3/demo/client/GwtBootstrap3DemoClientBundle.java</exclude>
            <exclude>org/gwtbootstrap3/demo/client/application/extras/**</exclude>
            <exclude>org/gwtbootstrap3/demo/client/application/css/validation/**</exclude>
            <!-- The GWT halves of the markdown seams; TeaVM copies sit beside them. -->
            <exclude>org/gwtbootstrap3/extras/markdown/client/Markdown.java</exclude>
            <exclude>org/gwtbootstrap3/extras/markdown/client/MarkdownClientBundle.java</exclude>
            <exclude>org/gwtbootstrap3/extras/markdown/client/MarkdownEntryPoint.java</exclude>
            <exclude>org/gwtbootstrap3/extras/markdown/client/ui/TextAreaSelection.java</exclude>
            <exclude>org/gwtbootstrap3/client/GwtBootstrap3EntryPoint.java</exclude>
            <exclude>org/gwtbootstrap3/client/GwtBootstrap3ClientBundle.java</exclude>
            <exclude>org/gwtbootstrap3/client/shared/js/JQuery.java</exclude>
            <exclude>org/gwtbootstrap3/client/ui/base/TooltipOptions.java</exclude>
            <exclude>org/gwtbootstrap3/client/ui/base/CarouselOptions.java</exclude>
          </excludes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>verify-bootstrap3-source-seams</id>
            <!-- After the unpack, since half the files it checks arrive there. -->
            <phase>process-sources</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireFilesExist>
                  <files>
                    <file>${project.build.directory}/shared-sources/org/gwtbootstrap3/client/GwtBootstrap3EntryPoint.java</file>
                    <file>${project.build.directory}/shared-sources/org/gwtbootstrap3/client/GwtBootstrap3ClientBundle.java</file>
                    <file>${project.build.directory}/shared-sources/org/gwtbootstrap3/client/shared/js/JQuery.java</file>
                    <file>${project.build.directory}/shared-sources/org/gwtbootstrap3/client/ui/base/TooltipOptions.java</file>
                    <file>${project.build.directory}/shared-sources/org/gwtbootstrap3/client/ui/base/CarouselOptions.java</file>
                    <file>${project.basedir}/src/main/java/org/gwtbootstrap3/client/TeaVmBootstrap3EntryPoint.java</file>
                    <file>${project.basedir}/src/main/java/org/gwtbootstrap3/client/Bootstrap3Resources.java</file>
                    <file>${project.basedir}/src/main/java/org/gwtbootstrap3/client/shared/js/JQuery.java</file>
                    <file>${project.basedir}/src/main/java/org/gwtbootstrap3/client/ui/base/TooltipOptions.java</file>
                    <file>${project.basedir}/src/main/java/org/gwtbootstrap3/client/ui/base/CarouselOptions.java</file>
                  </files>
                </requireFilesExist>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>${teavm.version}</version>
        <executions>
          <execution>
            <id>compile-teavm-smoke-app</id>
            <phase>process-classes</phase>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <mainClass>org.gwtbootstrap3.teavm.demo.SharedShowcaseApp</mainClass>
              <targetDirectory>${project.build.directory}/teavm</targetDirectory>
              <targetFileName>teavm-bootstrap3-showcase.js</targetFileName>
              <minifying>true</minifying>
              <sourceMapsGenerated>true</sourceMapsGenerated>
              <sourceFilesCopied>true</sourceFilesCopied>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
