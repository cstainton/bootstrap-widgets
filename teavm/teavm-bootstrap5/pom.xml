<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>teavm-bootstrap-widgets</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>teavm-bootstrap5</artifactId>
  <name>TeaVM Bootstrap 5</name>
  <packaging>jar</packaging>
  <description>Bootstrap 5-native TeaVM widget backend built without UiBinder or GWT DOM dependencies.</description>

  <dependencies>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>teavm-gwt-compat</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso-apis</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        The Bootstrap 5 widget API is compiled from the GWT module's own sources, so the
        TeaVM build and the GWT build share one definition of every widget rather than
        maintaining a parallel copy. Two groups are excluded:
          * the three classes that hold JSNI - the entry point, the event bridge and
            the component seam - which this module re-implements against TeaVM's
            @JSBody under the same package and API. Every widget is shared source.
      -->
      <!--
        The TeaVM equivalent of GWT's module declarations, read from the very same
        .gwt.xml files rather than declared again. Nothing is imposed on an
        application: it constructs a widget and the widget asks for what it needs.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>generate-teavm-modules</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>python3</executable>
              <arguments>
                <argument>${project.parent.parent.basedir}/scripts/generate-teavm-modules.py</argument>
                <argument>${project.parent.parent.basedir}/gwt/gwt-bootstrap5-extras/src/main/java</argument>
                <argument>${project.build.directory}/generated-sources/teavm-modules</argument>
                <argument>${project.build.directory}/teavm</argument>
                <argument>${project.build.outputDirectory}/META-INF/bootstrap5-assets</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-shared-bootstrap5-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.parent.parent.basedir}/gwt/gwt-bootstrap5/src/main/java</source>
                <source>${project.parent.parent.basedir}/gwt/gwt-bootstrap5-themes/src/main/java</source>
                <source>${project.parent.parent.basedir}/gwt/gwt-bootstrap5-extras/src/main/java</source>
                <source>${project.build.directory}/generated-sources/teavm-modules</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!--
            UiBinder for TeaVM. GWT reaches its generator through deferred binding,
            which TeaVM has no equivalent for; running the same step inside javac
            puts it somewhere both compilers can use, and gives it the real type
            model rather than an approximation of one. A module with no templates
            generates nothing, so this costs an application that does not use
            UiBinder exactly nothing.
          -->
          <annotationProcessorPaths>
            <path>
              <groupId>io.instanto</groupId>
              <artifactId>widget-processor</artifactId>
              <version>${project.version}</version>
            </path>
          </annotationProcessorPaths>
          <excludes>
            <exclude>io/instanto/bootstrap5/client/GwtBootstrap5EntryPoint.java</exclude>
            <exclude>io/instanto/bootstrap5/client/ui/base/BootstrapEventBridge.java</exclude>
            <exclude>io/instanto/bootstrap5/client/ui/base/BootstrapComponent.java</exclude>
            <exclude>io/instanto/bootstrap5/client/ui/base/InputEvents.java</exclude>
            <!--
              Only the Markdown extra crosses to TeaVM so far; the others still reach
              the browser through JSNI and a ClientBundle.
            -->
            <exclude>io/instanto/bootstrap5/extras/datepicker/**</exclude>
            <!--
              GWT-only pieces of the Markdown extra: the ClientBundle that inlines the
              vendored scripts and the entry point that injects them. MarkdownResources
              loads them by URL instead.
            -->
            <exclude>io/instanto/bootstrap5/extras/markdown/client/MarkdownClientBundle.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/markdown/client/MarkdownEntryPoint.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/markdown/client/Markdown.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/markdown/client/ui/TextAreaSelection.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/slider/client/SliderClientBundle.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/slider/client/SliderEntryPoint.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/slider/client/ui/SliderJs.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/richtext/client/RichTextClientBundle.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/richtext/client/RichTextEntryPoint.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/richtext/client/ui/QuillJs.java</exclude>
          </excludes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>verify-bootstrap5-source-seams</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireFilesExist>
                  <files>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap5/src/main/java/io/instanto/bootstrap5/client/GwtBootstrap5EntryPoint.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap5/src/main/java/io/instanto/bootstrap5/client/ui/base/BootstrapEventBridge.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap5/src/main/java/io/instanto/bootstrap5/client/ui/base/BootstrapComponent.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap5/src/main/java/io/instanto/bootstrap5/client/ui/base/InputEvents.java</file>
                    <file>${project.basedir}/src/main/java/io/instanto/bootstrap5/client/TeaVmBootstrap5EntryPoint.java</file>
                    <file>${project.basedir}/src/main/java/io/instanto/bootstrap5/client/ui/base/BootstrapEventBridge.java</file>
                    <file>${project.basedir}/src/main/java/io/instanto/bootstrap5/client/ui/base/BootstrapComponent.java</file>
                    <file>${project.basedir}/src/main/java/io/instanto/bootstrap5/client/ui/base/InputEvents.java</file>
                  </files>
                </requireFilesExist>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        The Markdown extra's scripts are inlined into the GWT output by a ClientBundle,
        so they are never emitted as files. TeaVM loads them by URL instead, which means
        shipping them beside the compiled module.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-extra-scripts</id>
            <phase>process-classes</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/teavm/js</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.parent.parent.basedir}/gwt/gwt-bootstrap5-extras/src/main/java/io/instanto/bootstrap5/extras/markdown/client/resource/js</directory>
                  <includes>
                    <include>*.js</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.parent.parent.basedir}/gwt/gwt-bootstrap5-extras/src/main/java/io/instanto/bootstrap5/extras/slider/client/resource/js</directory>
                  <includes>
                    <include>*.js</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.parent.parent.basedir}/gwt/gwt-bootstrap5-extras/src/main/java/io/instanto/bootstrap5/extras/richtext/client/resource/js</directory>
                  <includes>
                    <include>*.js</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>copy-extra-stylesheets</id>
            <phase>process-classes</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/teavm/css</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.parent.parent.basedir}/gwt/gwt-bootstrap5-extras/src/main/java/io/instanto/bootstrap5/extras/slider/client/resource/css</directory>
                  <includes>
                    <include>*.css</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.parent.parent.basedir}/gwt/gwt-bootstrap5-extras/src/main/java/io/instanto/bootstrap5/extras/richtext/client/resource/css</directory>
                  <includes>
                    <include>*.css</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.parent.parent.basedir}/gwt/gwt-bootstrap5/src/main/java/io/instanto/bootstrap5/client/resource/css</directory>
                  <includes>
                    <include>*.css</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.parent.parent.basedir}/gwt/gwt-bootstrap5-themes/src/main/java/io/instanto/bootstrap5/themes/client/resource/css</directory>
                  <includes>
                    <include>*.css</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
            <execution>
              <id>copy-icon-fonts</id>
              <phase>process-classes</phase>
              <goals>
                <goal>copy-resources</goal>
              </goals>
              <configuration>
                <outputDirectory>${project.build.directory}/teavm/fonts</outputDirectory>
                <resources>
                  <resource>
                    <directory>${project.parent.parent.basedir}/gwt/gwt-bootstrap5/src/main/java/io/instanto/bootstrap5/client/resource/fonts</directory>
                  </resource>
                </resources>
              </configuration>
            </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>${teavm.version}</version>
        <executions>
          <execution>
            <id>compile-teavm-bootstrap5-smoke-app</id>
            <phase>process-classes</phase>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <mainClass>io.instanto.bootstrap5.teavm.demo.Bootstrap5ShowcaseApp</mainClass>
              <targetDirectory>${project.build.directory}/teavm</targetDirectory>
              <targetFileName>teavm-bootstrap5-smoke.js</targetFileName>
              <minifying>true</minifying>
              <sourceMapsGenerated>true</sourceMapsGenerated>
              <sourceFilesCopied>true</sourceFilesCopied>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
