<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>teavm-bootstrap-widgets</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>teavm-bootstrap5</artifactId>
  <name>TeaVM Bootstrap 5</name>
  <packaging>jar</packaging>
  <description>Bootstrap 5-native TeaVM widget backend built without UiBinder or GWT DOM dependencies.</description>

  <dependencies>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>teavm-gwt-compat</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso-apis</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        The Bootstrap 5 widget API is compiled from the GWT module's own sources, so the
        TeaVM build and the GWT build share one definition of every widget rather than
        maintaining a parallel copy. Two groups are excluded:
          * the three classes that hold JSNI - the entry point, the event bridge and
            the component seam - which this module re-implements against TeaVM's
            @JSBody under the same package and API. Every widget is shared source.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-shared-bootstrap5-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.parent.parent.basedir}/gwt/gwt-bootstrap5/src/main/java</source>
                <source>${project.parent.parent.basedir}/gwt/gwt-bootstrap5-themes/src/main/java</source>
                <source>${project.parent.parent.basedir}/gwt/gwt-bootstrap5-extras/src/main/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>io/instanto/bootstrap5/client/GwtBootstrap5EntryPoint.java</exclude>
            <exclude>io/instanto/bootstrap5/client/ui/base/BootstrapEventBridge.java</exclude>
            <exclude>io/instanto/bootstrap5/client/ui/base/BootstrapComponent.java</exclude>
            <exclude>io/instanto/bootstrap5/client/ui/base/InputEvents.java</exclude>
            <!--
              Only the Markdown extra crosses to TeaVM so far; the others still reach
              the browser through JSNI and a ClientBundle.
            -->
            <exclude>io/instanto/bootstrap5/extras/datepicker/**</exclude>
            <exclude>io/instanto/bootstrap5/extras/richtext/**</exclude>
            <exclude>io/instanto/bootstrap5/extras/slider/**</exclude>
            <!--
              GWT-only pieces of the Markdown extra: the ClientBundle that inlines the
              vendored scripts and the entry point that injects them. MarkdownResources
              loads them by URL instead.
            -->
            <exclude>io/instanto/bootstrap5/extras/markdown/client/MarkdownClientBundle.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/markdown/client/MarkdownEntryPoint.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/markdown/client/Markdown.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/markdown/client/ui/TextAreaSelection.java</exclude>
          </excludes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>verify-bootstrap5-source-seams</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireFilesExist>
                  <files>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap5/src/main/java/io/instanto/bootstrap5/client/GwtBootstrap5EntryPoint.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap5/src/main/java/io/instanto/bootstrap5/client/ui/base/BootstrapEventBridge.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap5/src/main/java/io/instanto/bootstrap5/client/ui/base/BootstrapComponent.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap5/src/main/java/io/instanto/bootstrap5/client/ui/base/InputEvents.java</file>
                    <file>${project.basedir}/src/main/java/io/instanto/bootstrap5/client/TeaVmBootstrap5EntryPoint.java</file>
                    <file>${project.basedir}/src/main/java/io/instanto/bootstrap5/client/ui/base/BootstrapEventBridge.java</file>
                    <file>${project.basedir}/src/main/java/io/instanto/bootstrap5/client/ui/base/BootstrapComponent.java</file>
                    <file>${project.basedir}/src/main/java/io/instanto/bootstrap5/client/ui/base/InputEvents.java</file>
                  </files>
                </requireFilesExist>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        The Markdown extra's scripts are inlined into the GWT output by a ClientBundle,
        so they are never emitted as files. TeaVM loads them by URL instead, which means
        shipping them beside the compiled module.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-markdown-scripts</id>
            <phase>process-classes</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/teavm/js</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.parent.parent.basedir}/gwt/gwt-bootstrap5-extras/src/main/java/io/instanto/bootstrap5/extras/markdown/client/resource/js</directory>
                  <includes>
                    <include>*.js</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>${teavm.version}</version>
        <executions>
          <execution>
            <id>compile-teavm-bootstrap5-smoke-app</id>
            <phase>process-classes</phase>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <mainClass>io.instanto.bootstrap5.teavm.demo.Bootstrap5ShowcaseApp</mainClass>
              <targetDirectory>${project.build.directory}/teavm</targetDirectory>
              <targetFileName>teavm-bootstrap5-smoke.js</targetFileName>
              <minifying>true</minifying>
              <sourceMapsGenerated>true</sourceMapsGenerated>
              <sourceFilesCopied>true</sourceFilesCopied>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
