<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:io.instanto.bootstrap5.client.ui">

    <b:PanelBody>
        <b:Heading size="H4" text="Declared in UiBinder, compiled by TeaVM"/>
        <b:ButtonGroup>
            <b:Button type="PRIMARY" text="Primary"/>
            <b:Button type="SUCCESS" text="Success"/>
            <b:Button ui:field="counter" text="Clicked 0 times" data-testid="counter" aria-label="Click counter"/>
        </b:ButtonGroup>
        <b:FormGroup>
            <b:FormLabel text="Bound with ui:field"/>
            <b:TextBox ui:field="box" placeholder="the handler writes here"/>
        </b:FormGroup>
        <b:Alert type="INFO" dismissable="true">
            No template parsing happens in the browser: the build turned this file into
            <strong>ordinary Java</strong>. Mixed content, <i>inline markup</i> and
            <code data-testid="inline-code">plain elements</code> all come through.<br/>
            <a href="https://github.com/cstainton/bootstrap-widgets" data-testid="repo-link">The repository</a>
        </b:Alert>
    </b:PanelBody>
</ui:UiBinder>
