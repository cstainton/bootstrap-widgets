<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>bootstrap-widgets</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>teavm-bootstrap-widgets</artifactId>
  <packaging>pom</packaging>
  <name>TeaVM Bootstrap Widgets</name>

  <modules>
    <module>teavm-gwt-compat</module>
    <module>teavm-bootstrap3</module>
    <module>teavm-bootstrap5</module>
    <module>teavm-bootstrap-widget-tests</module>
    <module>teavm-gwt-compat-contracts</module>
  </modules>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>exclude-gwt-runtime-from-teavm</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>org.gwtproject:gwt-user</exclude>
                    <exclude>org.gwtproject:gwt-dev</exclude>
                    <exclude>com.google.gwt:gwt-user</exclude>
                    <exclude>com.google.gwt:gwt-dev</exclude>
                  </excludes>
                  <message>TeaVM modules must use teavm-gwt-compat, never gwt-user or gwt-dev.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
